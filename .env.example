PORT=8787
HOST=127.0.0.1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=API_KEY
LLM_MODEL=gpt-4o-mini
QQBOT_APP_ID=APP_ID
QQBOT_APP_SECRET=APP_SECRET
QQBOT_ALLOWED_OPENIDS=USER_OPENID_1,USER_OPENID_2

# 主控端与远程节点使用同一个强随机令牌
BRIGHTBOT_CONTROL_TOKEN=TOKEN

# 仅远程节点需要配置
BRIGHTBOT_MASTER_URL=https://MASTER_HOST
BRIGHTBOT_NODE_ID=server-2
BRIGHTBOT_NODE_NAME=业务服务器 2

# 节点 VNC 默认只连接节点本机；通常无需开放 5900 公网端口
BRIGHTBOT_VNC_HOST=127.0.0.1
BRIGHTBOT_VNC_PORT=5900

# Linux 内置纯命令行桌面（npm run vnc:install 会自动写入）
BRIGHTBOT_VNC_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
BRIGHTBOT_VNC_DISPLAY=:0
BRIGHTBOT_VNC_XAUTHORITY=/dev/null
BRIGHTBOT_VNC_AUTO_START=true
